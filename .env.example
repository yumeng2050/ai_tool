# ===== 模型接入（LM Studio 本地服务，OpenAI 兼容接口）=====
# 模型提供方：当前内置 lm_studio，后续可扩展其他 provider
LLM_PROVIDER=lm_studio
# LM Studio 开启 Local Server 后的地址
LLM_BASE_URL=http://localhost:1234/v1
# LM Studio 中加载的模型名（如 qwen2.5-9b 等，以 LM Studio 显示为准）
LLM_MODEL=qwen-9b
# 本地服务一般不校验密钥，随便填即可
LLM_API_KEY=lm-studio

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=60

# ===== 抓取策略 =====
RATE_LIMIT_SECONDS=1.5
MAX_DEPTH=1
# 正文最少有效字符数，低于此值视为无有效内容（默认 300）
MIN_CONTENT_CHARS=300
